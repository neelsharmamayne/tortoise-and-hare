# Copy to .env and fill in. Generate keys with:  npm run keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https: URL)
VAPID_SUBJECT=mailto:you@example.com
# Any long random string. Paste the same value into the app's Settings → Server token.
API_TOKEN=change-me-to-something-long-and-random
# Port to listen on
PORT=3000
